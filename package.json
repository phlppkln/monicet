{
	"name": "monicet",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite",
		"build": "vue-tsc --noEmit && vite build",
		"preview": "vite preview",
		"typecheck": "vue-tsc --noEmit",
		"test": "node --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "pnpm typecheck && pnpm test && pnpm format:check",
		"data:fetch": "node scripts/fetch-data.ts",
		"data:build": "node scripts/build-data.ts",
		"data:check": "node scripts/build-data.ts --check",
		"data:profile": "node scripts/profile-data.ts",
		"data:map-lines": "node scripts/build-map-lines.ts"
	},
	"dependencies": {
		"d3": "^7.9.0",
		"d3-tile": "^1.0.0",
		"vue": "^3.5.41"
	},
	"devDependencies": {
		"@types/d3": "^7.4.3",
		"@types/d3-tile": "^1.0.1",
		"@types/node": "^24.0.0",
		"@vitejs/plugin-vue": "^6.0.8",
		"prettier": "^3.9.6",
		"sass": "^1.102.0",
		"typescript": "^5.9.3",
		"vite": "^8.2.1",
		"vue-tsc": "^3.3.10"
	}
}
